[Unit]
Description=Volitex AI Inbox workflow failure email checks
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 /opt/volitex-ai-inbox/deployment/production/workflow_failure_alerts.py --config /etc/volitex/workflow-alerts.env --state /var/lib/volitex/workflow-alerts.json


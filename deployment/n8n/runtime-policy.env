# Versioned baseline for operator-managed HTTP/JSON automations. Add provider
# nodes only after their tenant, credential, input and recovery review.
# Keep main and worker on the same policy. An empty include list is not allowed.
NODES_INCLUDE=["n8n-nodes-base.webhook","n8n-nodes-base.respondToWebhook","n8n-nodes-base.httpRequest","n8n-nodes-base.set","n8n-nodes-base.if","n8n-nodes-base.switch","n8n-nodes-base.merge","n8n-nodes-base.wait","n8n-nodes-base.noOp","n8n-nodes-base.stopAndError","n8n-nodes-base.errorTrigger","n8n-nodes-base.scheduleTrigger","n8n-nodes-base.manualTrigger","n8n-nodes-base.splitInBatches","n8n-nodes-base.dateTime","n8n-nodes-base.dateTimeTool","n8n-nodes-base.httpRequestTool","CUSTOM.volitexReply"]
NODES_EXCLUDE=["n8n-nodes-base.executeCommand","n8n-nodes-base.localFileTrigger","n8n-nodes-base.git","n8n-nodes-base.ssh","n8n-nodes-base.code","n8n-nodes-base.emailSend","n8n-nodes-base.readWriteFile"]
N8N_DISABLED_MODULES=source-control,promotions,community-packages

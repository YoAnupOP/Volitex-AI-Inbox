# Canonical Coolify environment-variable schema for deployment/n8n-queue.compose.yaml.
# Copy these keys into the Coolify application's Environment Variables view. Replace
# every <...> value there; this file is intentionally safe to commit.
#
# Do not create or commit deployment/.env.n8n. The Compose file consumes Coolify
# variables directly and creates isolated n8n PostgreSQL and Valkey containers.

# Pin every image by immutable digest. These are the reviewed first-client images:
# n8n 2.40.3, PostgreSQL 17.11, and Valkey 8.1 (linux/amd64 VPS).
N8N_IMAGE=n8nio/n8n@sha256:e397d0aab215cc1a3ed865bd0c2d7982dff9390fa298f3c188d084425cd6fb16
N8N_POSTGRES_IMAGE=postgres@sha256:f4c66b820c6f974249089d3d16d86a3698eae11e8746eb6644b2271031e91232
N8N_VALKEY_IMAGE=valkey/valkey@sha256:3fbd2e3e4b6e85e046c1e7c215e8f79087bc0357789184305806664e320996f3

# Public n8n main process. Coolify terminates TLS and is the single trusted proxy.
N8N_HOST=automation.volitexai.tech
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_EDITOR_BASE_URL=https://automation.volitexai.tech
N8N_WEBHOOK_URL=https://automation.volitexai.tech
N8N_PROXY_HOPS=1

# Dedicated self-hosted n8n PostgreSQL. These values are not shared with Volitex Inbox.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=n8n-postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=volitex_n8n
DB_POSTGRESDB_USER=volitex_n8n
DB_POSTGRESDB_PASSWORD=<generated-n8n-postgres-password>
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_POOL_SIZE=5

# Dedicated self-hosted n8n Valkey. This value is not shared with Volitex Inbox Redis.
QUEUE_BULL_REDIS_HOST=n8n-valkey
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_DB=0
QUEUE_BULL_REDIS_PASSWORD=<generated-n8n-valkey-password>
QUEUE_BULL_PREFIX=volitex:n8n
EXECUTIONS_MODE=queue
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
QUEUE_HEALTH_CHECK_ACTIVE=true
QUEUE_HEALTH_CHECK_PORT=5678
N8N_WORKER_SERVER_ADDRESS=0.0.0.0

# Shared by n8n-main and n8n-worker. Retain it with every n8n database backup.
N8N_ENCRYPTION_KEY=<generated-n8n-encryption-key>
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_DEFAULT_BINARY_DATA_MODE=database
N8N_WORKER_CONCURRENCY=5

# Retain failed execution data for seven days and cap stored records. Successful
# executions are not retained because workflow payloads can contain client data.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false

# Security controls for this managed-service instance.
N8N_SECURE_COOKIE=true
N8N_MFA_ENABLED=true
N8N_OAUTH_BROWSER_BINDING=true
N8N_INVITE_LINKS_EMAIL_ONLY=true
N8N_PUBLIC_API_DISABLED=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_COMMUNITY_PACKAGES_ENABLED=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true
N8N_RESTRICT_FILE_ACCESS_TO=/home/node/.n8n-files
N8N_SSRF_PROTECTION_ENABLED=true
N8N_SSRF_BLOCKED_IP_RANGES=default

# Timezone and structured container logs.
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_LOG_FORMAT=json

# SMTP is required for the owner account, password recovery, and security notices.
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=<smtp-host>
N8N_SMTP_PORT=587
N8N_SMTP_USER=<smtp-user>
N8N_SMTP_PASS=<smtp-password>
N8N_SMTP_SSL=false
N8N_SMTP_STARTTLS=true
N8N_SMTP_SENDER=Volitex AI Automation <automation@volitexai.tech>

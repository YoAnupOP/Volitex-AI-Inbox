*.sh text eol=lf
/docker/entrypoints/helpers/pg_database_url.rb text eol=lf

# Keep Ruby and frontend source consistent across Windows and Linux CI.
*.rb text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.rake text eol=lf
*.jbuilder text eol=lf
*.ru text eol=lf
/Gemfile text eol=lf
/Rakefile text eol=lf
/Capfile text eol=lf

<li class="px-4 mb-1">
  <% text_class_name = current_page?(url) ? 'text-black dark:text-white bg-zinc-100 dark:bg-zinc-800' : 'text-zinc-800 dark:text-zinc-200' %>
  <%= link_to(url, class: text_class_name + " -ml-1 focus:outline-none cursor-pointer flex items-center px-2 py-1.5 hover:text-black dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg") do %>
    <svg width="16" height="16"><use xlink:href="#<%= icon %>" /></svg>
    <span class="ml-2 text-sm"><%= label %></span>
  <% end %>
</li>

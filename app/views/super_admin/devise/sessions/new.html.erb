<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="admin-auth">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Super Admin | Volitex AI Inbox</title>
    <script>
      (function() {
        try {
          var theme = localStorage.getItem('color_scheme');
          if (!theme || theme === 'auto') {
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            theme = prefersDark ? 'dark' : 'light';
          }
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" sizes="96x96">
    <link class="favicon" rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=2">
    <link class="favicon" rel="icon" type="image/svg+xml" sizes="any" href="/icon.svg?v=2">
    <link rel="shortcut icon" href="/favicon.ico?v=2">
    <link class="favicon" rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2">
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>
  </head>
  <body>
    <div class="h-full w-full antialiased">
      <main class="flex min-h-screen w-full flex-col bg-n-background px-4 py-12 text-n-slate-12 sm:px-6 sm:py-20 lg:px-8">
        <section class="mx-auto w-full max-w-lg">
          <img src="/brand-assets/logo.svg?v=2" alt="Volitex AI Inbox" class="mx-auto h-8 w-auto block dark:hidden">
          <img src="/brand-assets/logo_dark.svg?v=2" alt="Volitex AI Inbox" class="mx-auto h-8 w-auto hidden dark:block">
          <h2 class="mt-6 text-center text-3xl font-medium text-n-slate-12">
            Howdy, admin 👋
          </h2>
        </section>
        <section class="mx-auto mb-8 mt-10 w-full max-w-lg rounded-xl border border-n-weak bg-n-solid-1 p-6 shadow-sm sm:p-10">
          <div>
            <%= form_for(resource, as: resource_name, url: '/super_admin/sign_in') do |f| %>
              <% if flash[:error].present? %>
                <div data-alert role="alert" class="mb-5 rounded-md border border-n-ruby-6 bg-n-ruby-3 p-4 text-sm text-n-ruby-11"><%= flash[:error] %></div>
              <% end %>
              <div class="mb-5">
                <label for="super_admin_email" class="block text-sm font-medium leading-6 text-n-slate-12">
                Email Address
                </label>
                <div class="mt-1">
                  <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email eg: someone@example.com", class: "block w-full appearance-none rounded-md border border-n-strong bg-n-solid-2 px-3 py-3 text-n-slate-12 shadow-sm placeholder:text-n-slate-11 focus:border-n-slate-9 focus:outline-none focus:ring-2 focus:ring-n-slate-9 sm:text-sm sm:leading-6" %>
                </div>
              </div>
              <div class="mb-5">
                <label for="super_admin_password" class="block text-sm font-medium leading-6 text-n-slate-12">
                  Password
                </label>
                <div class="mt-1">
                  <%= f.password_field :password, autocomplete: "current-password",  placeholder: "Password", class: "block w-full appearance-none rounded-md border border-n-strong bg-n-solid-2 px-3 py-3 text-n-slate-12 shadow-sm placeholder:text-n-slate-11 focus:border-n-slate-9 focus:outline-none focus:ring-2 focus:ring-n-slate-9 sm:text-sm sm:leading-6" %>
                </div>
              </div>
              <button type="submit" class="flex w-full cursor-pointer items-center justify-center rounded-md bg-n-slate-12 px-3 py-3 text-base font-medium text-n-slate-1 shadow-sm hover:bg-n-slate-11 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-n-slate-9">
                <span>Login</span>
              </button>
            <% end %>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>

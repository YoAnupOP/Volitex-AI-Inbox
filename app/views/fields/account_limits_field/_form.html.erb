<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field space-y-3">
  <% field.limits.each do |key, value| %>
    <div>
      <%= label_tag "account_limits_#{key}", t("super_admin.account_limits.keys.#{key}"), class: 'font-normal' %>
      <%= number_field_tag "account[limits][#{key}]", value, id: "account_limits_#{key}", min: 0, step: 1,
                           class: 'mt-1 rounded border border-slate-300 bg-white p-2 focus:ring-black dark:focus:ring-white' %>
    </div>
  <% end %>
  <p class="text-sm text-zinc-500 dark:text-zinc-400"><%= t('super_admin.account_limits.hint') %></p>
</div>
